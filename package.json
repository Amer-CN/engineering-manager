    "@tauri-apps/plugin-store": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "docxtemplater": "^3.68.7",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^3.11.174",
    "pizzip": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
